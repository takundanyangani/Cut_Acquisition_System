# Copy to .env and fill in. Never commit the real .env.

# --- Core ---------------------------------------------------------------
DJANGO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=acquisitions.example.ac.zw
DJANGO_CSRF_TRUSTED_ORIGINS=https://acquisitions.example.ac.zw
# Origin only, no path: used in email links.
ACQ_SITE_URL=https://acquisitions.example.ac.zw
# Set when the app runs under a sub-path of the CUT portal, e.g. /ict-acquisitions
DJANGO_SCRIPT_NAME=
DJANGO_BEHIND_PROXY=true
ACQ_TRUST_X_FORWARDED_FOR=true

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://cutacq:change-me@localhost:5432/cutacq
POSTGRES_PASSWORD=change-me

# --- Email (the CUT mail server) -------------------------------------------
EMAIL_HOST=smtp.example.ac.zw
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ICT Acquisitions <ict-acquisitions@example.ac.zw>
DJANGO_ADMINS=ict-systems@example.ac.zw
# thread (default), cron (with the jobs service or crontab) or inline
ACQ_EMAIL_DELIVERY=thread

# --- Organisation ------------------------------------------------------------
ACQ_ORG_NAME=Chinhoyi University of Technology
ACQ_ORG_SHORT_NAME=CUT
ACQ_UNIT_NAME=ICT Services
ACQ_HELPDESK_CONTACT=the ICT Helpdesk

# --- Security ----------------------------------------------------------------
ACQ_SIGNATURE_REQUIRES_PASSWORD=true
ACQ_IDLE_TIMEOUT_MINUTES=30
ACQ_LOGIN_MAX_FAILURES=5
ACQ_LOGIN_LOCK_MINUTES=15
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false

# --- Uploads -------------------------------------------------------------------
ACQ_UPLOAD_ROOT=/srv/cut-acquisitions/var/uploads
ACQ_UPLOAD_MAX_MB=10

# --- Optional: sign in with the university directory (see docs/07-integration.md)
# LDAP_SERVER_URI=ldaps://dc1.example.ac.zw
# LDAP_BIND_DN=CN=svc-acquisitions,OU=Service Accounts,DC=example,DC=ac,DC=zw
# LDAP_BIND_PASSWORD=
# LDAP_USER_BASE_DN=OU=Staff,DC=example,DC=ac,DC=zw
# LDAP_USER_FILTER=(mail=%(user)s)
